{
  "_about": "Where each non-paginated reading lives in 00-source, for .claude/scripts/build_print_packets.py. Paginated cases (source bc/cp with start/end) come straight from case-index.json and need no entry here. Keys must match case-index.json reading names exactly. Part types: {file} = whole file; {file, pages} = explicit PDF page range; {section_in: <locator>, sections: [...]} = pages located by section heading; optional from_re / to_re narrow a single section to a subsection run.",

  "course": "Business Organizations",
  "source_short": {"bc": "B&C", "cp": "CP"},

  "locators": {
    "dgcl":     {"file": "DCGL 8 Full.pdf",         "head": "^§\\s*{sec}\\s+\\S",           "any": "^§\\s*\\d+[A-Z]?\\s+\\S",           "label": "DGCL § {sec}"},
    "chancery": {"file": "chancery rules 2026.pdf", "head": "^\\s*Rule\\s+{sec}\\.\\s+\\S", "any": "^\\s*Rule\\s+\\d+(\\.\\d+)?\\.\\s+\\S", "label": "Del. Ch. Ct. R. {sec}"},
    "sea34":    {"file": "sea1934.pdf",             "head": "^\\s*SEC\\.\\s*{sec}\\.",      "any": "^\\s*SEC\\.\\s*\\d+[A-Z]?\\.",      "label": "Exchange Act § {sec}"}
  },

  "readings": {
