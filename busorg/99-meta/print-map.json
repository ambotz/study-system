    "NVIDIA Certificate of Incorporation": [{"file": "Nvidia Certificate of Incorporation.pdf", "label": "Certificate (Canvas)"}],
    "NVIDIA Bylaws": [{"file": "Nvidia Bylaws.pdf", "label": "Bylaws (Canvas)"}],
    "University of Chicago Articles and Bylaws": [{"file": "U Chicago Governance Docs.pdf", "label": "Articles and Bylaws (Canvas)"}],

    "8 Del. C. 102(a)(3),(b)(1),(c); 109(b); 121; 122(1)-(17); 141(a),(b)": [{"section_in": "dgcl", "sections": ["102", "109", "121", "122", "141"]}],
    "8 Del. C. 122(18)": [{"section_in": "dgcl", "sections": ["122"]}],
    "8 Del. C. 102(b)(7)": [{"section_in": "dgcl", "sections": ["102"]}],
    "8 Del. C. 151, 157": [{"section_in": "dgcl", "sections": ["151", "157"]}],
    "8 Del. C. 141(d), 212, 216, 218": [{"section_in": "dgcl", "sections": ["141", "212", "216", "218"]}],
    "8 Del. C. 228(a)": [{"section_in": "dgcl", "sections": ["228"]}],
    "8 Del. C. 170, 154": [{"section_in": "dgcl", "sections": ["170", "154"]}],

    "8 Del. C. 144(a) (pre-SB 21)": [{"file": "8 Del. C. 144 (pre-SB 21).pdf", "label": "DGCL § 144 (pre-SB 21)"}],
    "8 Del. C. 144(a),(d)(6),(e)(4),(5),(7),(8),(d)(2),(3) (post-SB 21)": [{"file": "8 Del. C. 144 post-SB 21).pdf", "label": "DGCL § 144 (post-SB 21)"}],
    "8 Del. C. 144(b),(c),(e)(1),(2),(3) (post-SB 21)": [{"file": "8 Del. C. 144 post-SB 21).pdf", "label": "DGCL § 144 (post-SB 21)"}],
    "8 Del. C. 144(c) (post-SB 21)": [{"file": "8 Del. C. 144 post-SB 21).pdf", "label": "DGCL § 144 (post-SB 21)"}],
    "8 Del. C. 144(d)(6)(b) (post-SB 21)": [{"file": "8 Del. C. 144 post-SB 21).pdf", "label": "DGCL § 144 (post-SB 21)"}],
    "8 Del. C. 220 (pre-SB 21)": [{"file": "8 Del. C. 220 (pre-SB 21).pdf", "label": "DGCL § 220 (pre-SB 21)"}],
    "8 Del. C. 220 (post-SB 21)": [{"file": "8 Del. C. 220 (post-SB 21).pdf", "label": "DGCL § 220 (post-SB 21)"}],

    "Del. Ct. Ch. R. 23.1": [{"section_in": "chancery", "sections": ["23.1"]}],

    "1934 Act 13; SEC Rule 13D": [
