# OS
.DS_Store
._*

# Obsidian — per-machine UI state, not content
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.trash/

# Generated render output — regenerated from markdown, never authoritative
*.pdf.tmp
.pandoc-cache/

# Never commit credentials
.env
*.pem

# Course source material — stays on disk and in the OneDrive mirror, never in git.
# The casebook and case pack are large binaries git cannot diff or compress, and
# everything here is re-downloadable from Canvas. 00-source is an input folder;
# the repo tracks what we DERIVE from it, not the readings themselves.
*/00-source/**/*.pdf
*/00-source/**/*.epub
*/00-source/**/*.docx

# Generated from case-index.json by .claude/scripts/index_to_xlsx.py.
# Regenerated on demand; a tracked binary would churn on every regeneration.
*/99-meta/case-index.xlsx
